---
import type { NavItem } from "@/data/profile";
import { getAdjacentPages } from "@/lib/pageNavigation";
import { withBasePath } from "@/lib/sitePath";

interface Props {
  nav: readonly NavItem[];
  currentPath: string;
}

const { nav, currentPath } = Astro.props;
const { previous, next } = getAdjacentPages(nav, currentPath);
---

<nav class="page-turn-nav" aria-label="页面翻页导航">
  {
    previous && (
      <a
        class="page-turn page-turn--previous"
        href={withBasePath(previous.href)}
        rel="prev"
        aria-label={`上一页：${previous.label}`}
        data-cursor-target
      >
        <span class="page-turn__arrow" aria-hidden="true">
          ←
        </span>
        <span class="page-turn__copy">
          <span class="page-turn__direction">PREV</span>
          <span class="page-turn__label">{previous.label}</span>
        </span>
      </a>
    )
  }
  {
    next && (
      <a
        class="page-turn page-turn--next"
        href={withBasePath(next.href)}
        rel="next"
        aria-label={`下一页：${next.label}`}
        data-cursor-target
      >
        <span class="page-turn__arrow" aria-hidden="true">
          →
        </span>
        <span class="page-turn__copy">
          <span class="page-turn__direction">NEXT</span>
          <span class="page-turn__label">{next.label}</span>
        </span>
      </a>
    )
  }
</nav>

<style>
  .page-turn-nav {
    position: fixed;
    z-index: 45;
    inset: 0;
    pointer-events: none;
  }

  .page-turn {
    position: absolute;
    top: 50%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 2.75rem;
    min-height: 4.75rem;
    overflow: hidden;
    border: 1px solid rgba(117, 234, 216, 0.24);
    background:
      linear-gradient(135deg, rgba(117, 234, 216, 0.09), transparent 48%),
      rgba(9, 12, 23, 0.78);
    box-shadow:
      0 0 1.5rem rgba(117, 234, 216, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    color: var(--color-text);
    text-decoration: none;
    pointer-events: auto;
    transform: translateY(-50%);
    backdrop-filter: blur(14px);
    transition:
      width 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 220ms ease,
      background-color 220ms ease,
      box-shadow 220ms ease;
  }

  .page-turn--previous {
    left: 0;
    padding: 0.6rem 0.5rem;
    border-left: 0;
    border-radius: 0 1rem 1rem 0;
  }

  .page-turn--next {
    right: 0;
    flex-direction: row-reverse;
    padding: 0.6rem 0.5rem;
    border-right: 0;
    border-radius: 1rem 0 0 1rem;
    text-align: right;
  }

  .page-turn:hover,
  .page-turn:focus-visible {
    width: 8.5rem;
    border-color: rgba(117, 234, 216, 0.58);
    background-color: rgba(13, 19, 31, 0.94);
    box-shadow:
      0 0 2rem rgba(117, 234, 216, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .page-turn:focus-visible {
    outline: 2px solid var(--color-cyan);
    outline-offset: 3px;
  }

  .page-turn__arrow {
    flex: 0 0 1.75rem;
    color: var(--color-cyan);
    font-size: 1.25rem;
    line-height: 1;
    text-align: center;
    transition: transform 220ms ease;
  }

  .page-turn:hover .page-turn__arrow,
  .page-turn:focus-visible .page-turn__arrow {
    transform: translateX(-0.15rem);
  }

  .page-turn--next:hover .page-turn__arrow,
  .page-turn--next:focus-visible .page-turn__arrow {
    transform: translateX(0.15rem);
  }

  .page-turn__copy {
    display: grid;
    flex: 0 0 5.7rem;
    gap: 0.18rem;
    opacity: 0;
    transform: translateX(-0.4rem);
    transition:
      opacity 180ms ease 60ms,
      transform 240ms ease 40ms;
  }

  .page-turn--next .page-turn__copy {
    transform: translateX(0.4rem);
  }

  .page-turn:hover .page-turn__copy,
  .page-turn:focus-visible .page-turn__copy {
    opacity: 1;
    transform: none;
  }

  .page-turn__direction {
    color: var(--color-cyan);
    font:
      700 0.56rem/1 ui-monospace,
      SFMono-Regular,
      Consolas,
      monospace;
    letter-spacing: 0.16em;
  }

  .page-turn__label {
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  @media (max-width: 53.125rem) {
    .page-turn {
      top: auto;
      bottom: max(1rem, env(safe-area-inset-bottom));
      width: 2.75rem;
      min-height: 3.75rem;
      padding: 0.5rem;
      transform: none;
    }

    .page-turn:hover,
    .page-turn:focus-visible {
      width: 2.75rem;
    }

    .page-turn__copy {
      display: none;
    }

    .page-turn__arrow {
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-turn,
    .page-turn__arrow,
    .page-turn__copy {
      transition: none;
    }
  }
</style>
