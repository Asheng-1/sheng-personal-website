---
import { ShinyText } from "@/components/effects/ShinyText";
import type { NavItem } from "@/data/profile";
import { withBasePath } from "@/lib/sitePath";

interface Props {
  name: string;
  nav: readonly NavItem[];
  currentPath: string;
}

const { name, nav, currentPath } = Astro.props;
const normalizedPath =
  currentPath === "/" ? "/" : currentPath.replace(/\/$/, "");
const systemLabels: Record<NavItem["href"], string> = {
  "/": "HOME",
  "/learning": "PROFILE",
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a
      class="site-header__brand"
      href={withBasePath("/")}
      aria-label={`${name} 首页`}
    >
      {name.toUpperCase()} / OS
    </a>
    <div class="site-header__nav">
      <nav aria-label="Primary navigation" class="section-nav">
        {
          nav.map(({ href, label }) => (
            <a
              aria-label={label}
              aria-current={normalizedPath === href ? "page" : undefined}
              class="section-nav__link"
              href={withBasePath(href)}
            >
              <span class="section-nav__code">{systemLabels[href]}</span>
              <span class="sr-only">{label}</span>
            </a>
          ))
        }
      </nav>
    </div>
    <p class="site-header__status" aria-label="System status: online">
      <span aria-hidden="true"></span>
      <ShinyText
        text="SYS ONLINE"
        speed={6}
        delay={0.8}
        color="#75ead8"
        shineColor="#ffffff"
        spread={52}
        direction="left"
      />
    </p>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    box-sizing: border-box;
    height: 5rem;
    padding: 0.75rem 1rem 0;
    background: linear-gradient(
      to bottom,
      rgba(7, 8, 17, 0.82),
      rgba(7, 8, 17, 0)
    );
  }

  .site-header__inner {
    display: grid;
    box-sizing: border-box;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    width: min(100%, 100rem);
    min-height: 4.25rem;
    margin: 0 auto;
    padding: 0 1.1rem;
    border: 1px solid rgba(137, 161, 188, 0.2);
    border-radius: 0.875rem;
    background: linear-gradient(
      90deg,
      rgba(12, 18, 28, 0.9),
      rgba(7, 10, 18, 0.72)
    );
    box-shadow:
      0 1rem 2.5rem rgba(0, 0, 0, 0.28),
      inset 0 1px rgba(255, 255, 255, 0.04),
      0 0 0 1px rgba(117, 234, 216, 0.025);
    backdrop-filter: blur(22px);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: var(--color-text);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-decoration: none;
  }

  .site-header__status {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-cyan);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .site-header__status > span {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 0.7rem rgba(117, 234, 216, 0.9);
  }

  .site-header__nav {
    min-width: 0;
    height: 100%;
    justify-self: center;
  }

  :global(.section-nav) {
    position: relative;
    display: flex;
    align-items: center;
    height: 4.25rem;
    isolation: isolate;
  }

  :global(.section-nav__link) {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 7.5rem;
    height: 100%;
    padding: 0 1.35rem;
    border-left: 1px solid rgba(137, 161, 188, 0.13);
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition:
      color 220ms ease,
      background-color 220ms ease;
    isolation: isolate;
  }

  :global(.section-nav__link:last-child) {
    border-right: 1px solid rgba(137, 161, 188, 0.13);
  }

  :global(.section-nav__link::before) {
    position: absolute;
    z-index: -1;
    right: 1rem;
    bottom: 0;
    left: 1rem;
    height: 2px;
    background: var(--color-cyan);
    box-shadow: 0 0 0.75rem rgba(117, 234, 216, 0.8);
    content: "";
    opacity: 0;
    transform: scaleX(0.35);
    transition:
      opacity 220ms ease,
      transform 320ms ease;
  }

  :global(.section-nav__link::after) {
    position: absolute;
    top: 0.85rem;
    right: 50%;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 0.6rem rgba(117, 234, 216, 0.9);
    content: "";
    opacity: 0;
    transform: translateX(50%) scale(0);
    transition:
      opacity 180ms ease,
      transform 320ms ease;
  }

  :global(.section-nav__link:hover),
  :global(.section-nav__link:focus-visible) {
    color: var(--color-text);
    background: rgba(117, 234, 216, 0.035);
  }

  :global(.section-nav__link:hover::before),
  :global(.section-nav__link:focus-visible::before) {
    opacity: 0.5;
    transform: scaleX(0.72);
  }

  :global(.section-nav__link[aria-current="page"]) {
    color: var(--color-text);
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(117, 234, 216, 0.06)
    );
  }

  :global(.section-nav__link[aria-current="page"]::before) {
    opacity: 1;
    transform: scaleX(1);
  }

  :global(.section-nav__link[aria-current="page"]::after) {
    opacity: 1;
    transform: translateX(50%) scale(1);
  }

  :global(.section-nav__code) {
    position: relative;
    z-index: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 47rem) and (min-width: 72.126rem) {
    .site-header {
      height: 4.5rem;
      padding: 0.55rem 0.75rem 0;
    }

    .site-header__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.55rem;
      min-height: 3.75rem;
      padding: 0 0.7rem;
    }

    .site-header__nav {
      min-width: 0;
      justify-self: end;
    }

    :global(.section-nav) {
      height: 3.75rem;
      overflow-x: auto;
      max-width: 100%;
    }

    .site-header__status {
      display: none;
    }

    .site-header__brand {
      font-size: 0.6rem;
    }

    :global(.section-nav__link) {
      min-width: 0;
      padding-inline: 0.8rem;
      font-size: 0.56rem;
    }
  }

  @media (max-width: 23rem) and (min-width: 72.126rem) {
    .site-header__brand {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .site-header__nav {
      justify-self: center;
    }
  }
</style>
