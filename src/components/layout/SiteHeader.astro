---
import type { NavItem } from "@/data/profile";

interface Props {
  name: string;
  nav: readonly NavItem[];
  currentPath: string;
}

const { name, nav, currentPath } = Astro.props;
const normalizedPath =
  currentPath === "/" ? "/" : currentPath.replace(/\/$/, "");
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${name} 首页`}>
      {name.toUpperCase()} / LAB
    </a>
    <div class="site-header__nav">
      <nav aria-label="Primary navigation" class="section-nav">
        {
          nav.map(({ href, label }) => (
            <a
              aria-current={normalizedPath === href ? "page" : undefined}
              class="section-nav__link"
              href={href}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="site-header__status" aria-label="System status: online">
      SYS ONLINE
    </p>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--color-border);
    background: rgba(7, 8, 17, 0.82);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    width: min(100% - 2rem, var(--content-wide));
    min-height: 5rem;
    margin: 0 auto;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-decoration: none;
  }

  .site-header__status {
    justify-self: end;
    margin: 0;
    color: var(--color-cyan);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .site-header__nav {
    min-width: 0;
    justify-self: center;
  }

  :global(.section-nav) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgba(7, 8, 17, 0.6);
  }

  :global(.section-nav__link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.8rem;
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  :global(.section-nav__link[aria-current="page"]) {
    background: var(--color-violet);
    color: var(--color-bg);
  }

  @media (max-width: 47rem) {
    .site-header__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.65rem;
      min-height: 4.5rem;
    }

    .site-header__nav {
      min-width: 0;
      justify-self: end;
    }

    :global(.section-nav) {
      overflow-x: auto;
      max-width: 100%;
    }

    .site-header__status {
      display: none;
    }

    .site-header__brand {
      font-size: 0.68rem;
    }

    :global(.section-nav__link) {
      padding-inline: 0.62rem;
      font-size: 0.66rem;
    }
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
      padding-block: 0.5rem;
    }

    .site-header__brand,
    .site-header__nav {
      justify-self: center;
    }

    :global(.section-nav) {
      justify-content: center;
      overflow: visible;
    }
  }
</style>
