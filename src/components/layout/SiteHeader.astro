---
import type { NavItem } from "@/data/profile";

interface Props {
  name: string;
  nav: readonly NavItem[];
  currentPath: string;
}

const { name, nav, currentPath } = Astro.props;
const normalizedPath =
  currentPath === "/" ? "/" : currentPath.replace(/\/$/, "");
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${name} 首页`}>
      {name.toUpperCase()} / LAB
    </a>
    <div class="site-header__nav">
      <nav aria-label="Primary navigation" class="section-nav">
        {
          nav.map(({ href, label }) => (
            <a
              aria-current={normalizedPath === href ? "page" : undefined}
              class="section-nav__link"
              href={href}
            >
              <span class="section-nav__label">{label}</span>
            </a>
          ))
        }
      </nav>
    </div>
    <p class="site-header__status" aria-label="System status: online">
      SYS ONLINE
    </p>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--color-border);
    background: rgba(7, 8, 17, 0.82);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    width: min(100% - 2rem, var(--content-wide));
    min-height: 5rem;
    margin: 0 auto;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-decoration: none;
  }

  .site-header__status {
    justify-self: end;
    margin: 0;
    color: var(--color-cyan);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .site-header__nav {
    min-width: 0;
    justify-self: center;
  }

  :global(.section-nav) {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgba(7, 8, 17, 0.72);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 0.75rem 2.5rem rgba(0, 0, 0, 0.18);
    isolation: isolate;
  }

  :global(.section-nav__link) {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.8rem;
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 220ms ease;
    isolation: isolate;
  }

  :global(.section-nav__link::before) {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      120deg,
      var(--color-violet),
      #7564ff 58%,
      var(--color-cyan)
    );
    box-shadow:
      0 0 1rem rgba(145, 127, 255, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
    content: "";
    opacity: 0;
    transform: scale(0.72);
    transition:
      opacity 220ms ease,
      transform 420ms cubic-bezier(0.2, 0.9, 0.2, 1.25);
  }

  :global(.section-nav__link::after) {
    position: absolute;
    top: 50%;
    right: 0.35rem;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 0.6rem rgba(117, 234, 216, 0.9);
    content: "";
    opacity: 0;
    transform: translateY(-50%) scale(0);
    transition:
      opacity 180ms ease,
      transform 380ms cubic-bezier(0.2, 0.9, 0.2, 1.4);
  }

  :global(.section-nav__link:hover::before),
  :global(.section-nav__link:focus-visible::before) {
    opacity: 0.24;
    transform: scale(0.9);
  }

  :global(.section-nav__link[aria-current="page"]) {
    color: var(--color-bg);
  }

  :global(.section-nav__link[aria-current="page"]::before) {
    opacity: 1;
    transform: scale(1);
  }

  :global(.section-nav__link[aria-current="page"]::after) {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  :global(.section-nav__label) {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 47rem) {
    .site-header__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.65rem;
      min-height: 4.5rem;
    }

    .site-header__nav {
      min-width: 0;
      justify-self: end;
    }

    :global(.section-nav) {
      overflow-x: auto;
      max-width: 100%;
    }

    .site-header__status {
      display: none;
    }

    .site-header__brand {
      font-size: 0.68rem;
    }

    :global(.section-nav__link) {
      padding-inline: 0.62rem;
      font-size: 0.66rem;
    }
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .site-header__nav {
      justify-self: center;
    }

    .site-header__brand {
      display: none;
    }

    :global(.section-nav) {
      justify-content: center;
      overflow: visible;
    }
  }
</style>
