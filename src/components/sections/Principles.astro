---
import { ScrollReveal } from '@/components/effects/ScrollReveal';
import type { ContentItem } from '@/data/profile';

interface Props {
  items: readonly ContentItem[];
}

const { items } = Astro.props;
---

<section
  id="principles"
  class="content-section principles"
  aria-labelledby="principles-title"
>
  <ScrollReveal client:visible className="section-reveal">
    <header class="section-heading">
      <p class="section-kicker">PRINCIPLES / 04</p>
      <h2 id="principles-title">判断回答的三个准则</h2>
      <p>不使用分数包装能力，只说明每次练习时反复检查的方向。</p>
    </header>
    <ul class="principles__grid">
      {
        items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))
      }
    </ul>
  </ScrollReveal>
</section>

<style>
  .principles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    list-style: none;
  }

  li {
    min-height: 11rem;
    padding: 1.5rem;
    border-top: 1px solid var(--color-violet);
    background: linear-gradient(
      180deg,
      rgba(145, 127, 255, 0.1),
      transparent 72%
    );
  }

  h3 {
    margin: 0;
    color: var(--color-cyan);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.03em;
  }

  li p {
    margin: 1rem 0 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  @media (max-width: 53.125rem) {
    .principles__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    li {
      min-height: 0;
    }
  }
</style>
