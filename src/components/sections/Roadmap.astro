---
import { GridScan } from '@/components/effects/GridScan';
import { ScrollReveal } from '@/components/effects/ScrollReveal';
import type { ContentItem } from '@/data/profile';

interface Props {
  items: readonly ContentItem[];
}

const { items } = Astro.props;
---

<section
  id="roadmap"
  class="content-section roadmap"
  aria-labelledby="roadmap-title"
>
  <ScrollReveal client:visible className="section-reveal">
    <header class="section-heading">
      <p class="section-kicker">ROADMAP / 03</p>
      <h2 id="roadmap-title">一步一步，走进入行现场</h2>
      <p>这不是已经完成的履历，而是一条会根据练习反馈持续调整的学习路线。</p>
    </header>
    <div class="roadmap__stage">
      <GridScan client:visible />
      <ol>
        {
          items.map((item, index) => (
            <li>
              <span class="roadmap__step" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </ScrollReveal>
</section>

<style>
  .roadmap__stage {
    position: relative;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    overflow: hidden;
    isolation: isolate;
  }

  ol {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  ol::before {
    position: absolute;
    z-index: -1;
    top: 1.1rem;
    right: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-cyan), var(--color-violet));
    content: '';
  }

  li {
    min-width: 0;
  }

  .roadmap__step {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-cyan);
    background: var(--color-bg);
    color: var(--color-cyan);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 1.4rem 0 0;
    font-size: 1.2rem;
  }

  li p {
    margin: 0.65rem 0 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  @media (max-width: 53.125rem) {
    .roadmap__stage {
      padding: 1.5rem;
    }

    ol {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-left: 0.2rem;
    }

    ol::before {
      top: 0;
      bottom: 0;
      left: 1.3rem;
      width: 1px;
      height: auto;
      background: linear-gradient(
        180deg,
        var(--color-cyan),
        var(--color-violet)
      );
    }

    li {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr);
      column-gap: 1rem;
    }

    .roadmap__step {
      grid-row: 1 / span 2;
    }

    h3,
    li p {
      grid-column: 2;
    }

    h3 {
      margin-top: 0.3rem;
    }
  }
</style>
