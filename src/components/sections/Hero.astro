---
import { FramelessPortrait } from "@/components/effects/FramelessPortrait";
import { QuantumNetworkBackground } from "@/components/effects/QuantumNetworkBackground";
import { DecryptedText } from "@/components/effects/DecryptedText";
import { ClickSpark } from "@/components/effects/ClickSpark";
import { SpecularButton } from "@/components/effects/SpecularButton";
import type { Profile } from "@/data/profile";
import { Picture } from "astro:assets";
import heroImage from "@/assets/sheng-ip-hero.png";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const [heroLead, heroEmphasis] = profile.heroStatement.split("，");
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero__static-network" aria-hidden="true"><span></span></div>
  <QuantumNetworkBackground client:load particleCount={58} />
  <div class="hero__copy">
    <p class="hero__hello">{profile.eyebrow}</p>
    <p class="hero__role"><DecryptedText client:load text={profile.role} /></p>
    <h1 id="hero-title">{heroLead}，<span>{heroEmphasis}</span></h1>
    <p class="hero__intro">{profile.introduction}</p>
    <div class="hero__actions">
      <SpecularButton
        client:visible
        className="hero__action hero__action--secondary"
        href="/learning"
        size="lg"
        radius={18}
        tint="#917fff"
        tintOpacity={0.06}
        blur={0}
        textColor="#f5f5f5"
        lineColor="#ffffff"
        baseColor="#1b1d28"
        intensity={0.72}
        shineSize={10}
        shineFade={40}
        thickness={1}
        speed={0.35}
        followMouse
        proximity={250}
        autoAnimate={false}>正在学习</SpecularButton
      >
      <SpecularButton
        client:visible
        className="hero__action hero__action--primary"
        href="/roadmap"
        size="lg"
        radius={18}
        tint="#ffffff"
        tintOpacity={0}
        blur={0}
        textColor="#f5f5f5"
        lineColor="#ffffff"
        baseColor="#525252"
        intensity={1}
        shineSize={10}
        shineFade={40}
        thickness={1}
        speed={0.35}
        followMouse
        proximity={250}
        autoAnimate={false}>查看入行路线</SpecularButton
      >
    </div>
  </div>
  <div class="hero__visual">
    <FramelessPortrait client:load>
      <Picture
        src={heroImage}
        formats={["avif", "webp"]}
        fallbackFormat="png"
        widths={[640, 960, 1440, 1672]}
        sizes="(max-width: 850px) calc(100vw - 1.5rem), min(54vw, 736px)"
        quality={100}
        alt="Sheng 的 3D IP 形象"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </FramelessPortrait>
    <div class="hero__telemetry" aria-hidden="true">
      PROFILE / SHENG<br />SCAN COMPLETE
    </div>
  </div>
  <ClickSpark client:idle targets={[".hero__actions a"]} />
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    box-sizing: border-box;
    grid-template-columns: minmax(0, 0.88fr) minmax(23rem, 1.12fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    width: min(100% - 2rem, var(--content-wide));
    min-height: calc(100svh - 5rem);
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 5rem) 0;
    scroll-margin-top: 5.5rem;
    isolation: isolate;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .hero__static-network {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: visible;
    pointer-events: none;
    opacity: 0.5;
  }

  .hero__static-network::before {
    position: absolute;
    right: -12%;
    bottom: -16%;
    left: 28%;
    height: 58%;
    background-image:
      linear-gradient(rgba(117, 234, 216, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(145, 127, 255, 0.1) 1px, transparent 1px);
    background-size: 2.6rem 2.6rem;
    content: "";
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 24%,
      #000 78%,
      transparent
    );
    transform: perspective(28rem) rotateX(62deg);
    transform-origin: bottom;
  }

  .hero__static-network::after {
    position: absolute;
    inset: 8% 2% 12% 16%;
    background:
      linear-gradient(
        118deg,
        transparent 22%,
        rgba(145, 127, 255, 0.18) 22.2%,
        transparent 22.5%
      ),
      linear-gradient(
        24deg,
        transparent 61%,
        rgba(117, 234, 216, 0.14) 61.2%,
        transparent 61.5%
      );
    content: "";
  }

  .hero__static-network span {
    position: absolute;
    top: 16%;
    right: 17%;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow:
      -19rem 7rem 0 -0.08rem var(--color-violet),
      8rem 13rem 0 -0.1rem var(--color-cyan),
      -8rem 24rem 0 -0.08rem var(--color-violet);
  }

  .hero__hello,
  .hero__role {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .hero__hello {
    color: var(--color-cyan);
  }

  .hero__role {
    margin-top: 0.65rem;
    color: var(--color-muted);
  }

  h1 {
    max-width: 8ch;
    margin: 1.5rem 0 0;
    font-size: clamp(3rem, 6vw, 5.85rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  h1 span {
    display: block;
    color: var(--color-violet);
  }

  .hero__intro {
    max-width: 38rem;
    margin: 1.6rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__actions :global(.hero__action) {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .hero__actions :global(.hero__action--primary) {
    box-shadow: 0 0.9rem 2.5rem rgba(117, 234, 216, 0.1);
  }

  .hero__actions :global(.hero__action--secondary) {
    opacity: 0.9;
  }

  .hero__visual {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: clamp(35rem, 50vw, 45rem);
    isolation: isolate;
  }

  .hero__visual::before {
    position: absolute;
    z-index: -2;
    width: min(76%, 34rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(145, 127, 255, 0.4),
      rgba(145, 127, 255, 0) 68%
    );
    content: "";
    filter: blur(14px);
  }

  .hero__visual::after {
    position: absolute;
    z-index: -1;
    right: 4%;
    bottom: 6%;
    left: 4%;
    height: 30%;
    background-image:
      linear-gradient(rgba(117, 234, 216, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(145, 127, 255, 0.11) 1px, transparent 1px);
    background-size: 2.25rem 2.25rem;
    content: "";
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 24%,
      transparent 92%
    );
    opacity: 0.68;
    transform: perspective(28rem) rotateX(64deg);
    transform-origin: bottom;
  }

  :global(.frameless-portrait) {
    position: relative;
    z-index: 1;
    width: min(118%, 50rem);
    aspect-ratio: 0.82;
    overflow: hidden;
    transform: translate(clamp(2.5rem, 4.25vw, 4rem), -2.75rem);
  }

  :global(.frameless-portrait picture) {
    position: absolute;
    inset: 0 -85%;
    display: grid;
    place-items: center;
  }

  :global(.frameless-portrait img) {
    display: block;
    width: auto;
    max-width: none;
    height: min(80svh, 46rem);
    -webkit-mask-image: radial-gradient(
      ellipse 15.5% 52% at 50% 50%,
      #000 62%,
      rgba(0, 0, 0, 0.96) 74%,
      rgba(0, 0, 0, 0.3) 88%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 15.5% 52% at 50% 50%,
      #000 62%,
      rgba(0, 0, 0, 0.96) 74%,
      rgba(0, 0, 0, 0.3) 88%,
      transparent 100%
    );
    filter: contrast(1.035) saturate(1.035);
    transition: transform 180ms ease-out;
    will-change: transform;
  }

  .hero__telemetry {
    position: absolute;
    top: 13%;
    left: 1%;
    color: var(--color-muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.8;
    opacity: 0.8;
  }

  @media (max-width: 53.125rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
      gap: 0.5rem;
      padding-block: clamp(2.75rem, 8vw, 4rem) 2.5rem;
    }

    .hero__visual {
      min-height: clamp(31rem, 105vw, 39rem);
    }

    :global(.frameless-portrait) {
      width: min(100%, 34rem);
      overflow: hidden;
      transform: none;
    }

    :global(.frameless-portrait img) {
      height: 112%;
    }
  }

  @media (max-width: 30rem) {
    .hero {
      width: min(100% - 1.5rem, var(--content-wide));
    }

    h1 {
      font-size: clamp(2.75rem, 14vw, 4rem);
    }

    .hero__visual {
      min-height: 30rem;
      margin-top: 0.5rem;
    }

    :global(.frameless-portrait) {
      width: min(112%, 28rem);
    }

    .hero__telemetry {
      display: none;
    }
  }
</style>
