---
import { ScrollReveal } from "@/components/effects/ScrollReveal";
import { SpotlightCard } from "@/components/effects/SpotlightCard";
import type { LearningItem } from "@/data/profile";

interface Props {
  items: readonly LearningItem[];
}

const { items } = Astro.props;
---

<section
  id="learning"
  class="content-section learning"
  aria-labelledby="learning-title"
>
  <ScrollReveal client:visible className="section-reveal">
    <header class="section-heading">
      <p class="section-kicker">LEARNING / 02</p>
      <h2 id="learning-title">正在建立的能力</h2>
      <p>从具体、可复盘的小练习开始，把理解逐步变成稳定的方法。</p>
    </header>
    <ul class="learning__grid" aria-label="正在建立的能力">
      {
        items.map((item) => (
          <li>
            <SpotlightCard client:visible>
              <span class="learning__marker" aria-hidden="true" />
              <p class="learning__status">{item.status}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </SpotlightCard>
          </li>
        ))
      }
    </ul>
  </ScrollReveal>
</section>

<style>
  .learning__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    list-style: none;
  }

  .learning__grid li {
    min-width: 0;
  }

  :global(.learning .spotlight-card) {
    min-height: 15rem;
  }

  .learning__marker {
    display: block;
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid var(--color-cyan);
    transform: rotate(45deg);
  }

  .learning__status {
    margin: 0.85rem 0 0;
    color: var(--color-cyan);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  h3 {
    margin: auto 0 0;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    letter-spacing: -0.025em;
  }

  li p:not(.learning__status) {
    margin: 0.7rem 0 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  @media (max-width: 53.125rem) {
    .learning__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(.learning .spotlight-card) {
      min-height: 12rem;
    }
  }
</style>
