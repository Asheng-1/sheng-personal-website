---
import { profile } from '@/data/profile';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Hero from '@/components/sections/Hero.astro';
---

<BaseLayout title={`${profile.name} | ${profile.role}`} description={profile.introduction}>
  <SiteHeader name={profile.name} nav={profile.nav} />
  <Hero profile={profile} />
  <!-- Task 6 replaces these temporary anchor targets with the content sections. -->
  <div id="learning" class="anchor-sentinel" aria-hidden="true"></div>
  <div id="roadmap" class="anchor-sentinel" aria-hidden="true"></div>
  <SiteFooter />
</BaseLayout>

<style>
  .anchor-sentinel {
    min-height: 1px;
    scroll-margin-top: 1rem;
  }
</style>
