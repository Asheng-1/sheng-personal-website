---
import { profile } from "@/data/profile";
import SiteLayout from "@/layouts/SiteLayout.astro";
import AboutShowcase from "@/components/sections/AboutShowcase.astro";
---

<SiteLayout
  title={`关于我 | ${profile.name}`}
  description="来自广东广州的 Sheng，关于他的个人介绍与作品。"
  showFooter={false}
>
  <AboutShowcase content={profile.about} contact={profile.contact} />
</SiteLayout>
